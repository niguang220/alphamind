# AlphaMind environment configuration sample
# Copy this file to .env and fill in real values.
#
# It is split into three sections — read the headings, they mean different things:
#   1) Wired up      — read directly by the code; changing it takes effect immediately
#   2) Not wired yet — the mechanism exists but its parameter is hardcoded; each entry
#                      points at the file:line holding the current default, and wiring
#                      one up is usually a one-line change
#   3) Unimplemented — no code behind it; setting it has no effect whatsoever

# ══════════════════════════════════════════════════════════════════════════════
# 1) Wired up
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: point at an Anthropic-compatible third-party API (for example DeepSeek)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional: override the model (default claude-3-5-sonnet-20241022).
# Use deepseek-chat. Do NOT use deepseek-v4-pro: it is a reasoning model whose
# thinking block consumes the whole max_tokens budget, leaving the text block empty.
# ANTHROPIC_MODEL=deepseek-chat

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Consumed by docker-compose.yml (the redis --requirepass flag and the REDIS_URL it builds)
REDIS_PASSWORD=alphamind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Fallback path used automatically when the ChromaDB service is unreachable
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
# Sampling interval in seconds
MONITOR_INTERVAL=10
# Alert webhook; leave empty to log alerts without sending them anywhere
ALERT_WEBHOOK_URL=

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ────────────────────────────────────────────────────────────────────
# Defaults to the in-repo ./skills; POST /skills/reload hot-reloads at runtime
ALPHAMIND_SKILLS_DIR=./skills
ALPHAMIND_SKILLS_MAX_PROMPT_CHARS=5000


# ══════════════════════════════════════════════════════════════════════════════
# 2) Not wired yet: the mechanism exists, the parameter is hardcoded.
#    The values below are the current defaults in the code.
# ══════════════════════════════════════════════════════════════════════════════

# ── Intent recognition ────────────────────────────────────────────────────────
# Below this fused-vote confidence the intent falls back to OTHER — core/intent_recognizer.py:168
# INTENT_CONFIDENCE_THRESHOLD=0.5
# LRU cache capacity for recognition results — core/intent_recognizer.py:233
# INTENT_CACHE_SIZE=1000

# ── Agent ─────────────────────────────────────────────────────────────────────
# Token ceiling for a single reply — agents/agent_orchestrator.py:182
# AGENT_MAX_TOKENS=2048

# ── MCP tool governance ───────────────────────────────────────────────────────
# Per-call tool timeout in seconds — mcp/tool_manager.py:118
# TOOL_TIMEOUT=30
# Tool result cache TTL in seconds, 0 disables caching — mcp/tool_manager.py:117
# TOOL_CACHE_TTL=0
# Circuit breaker: consecutive failures before it opens — mcp/tool_manager.py:80
# TOOL_CIRCUIT_BREAKER_THRESHOLD=5
# Circuit breaker: seconds before it probes in HALF_OPEN — mcp/tool_manager.py:80
# TOOL_CIRCUIT_BREAKER_TIMEOUT=60

# ── Memory ────────────────────────────────────────────────────────────────────
# Working-memory messages before LLM compression kicks in — memory/conversation_memory.py:83
# MEMORY_MAX_WORKING=20

# ── Monitoring ────────────────────────────────────────────────────────────────
# Sliding-window Z-score sensitivity, in standard deviations — monitor/performance_monitor.py:69
# ANOMALY_DETECTION_SENSITIVITY=2.5

# ── API behaviour ─────────────────────────────────────────────────────────────
# CORS allowlist, currently hardcoded to * — api/main.py:197
# CORS_ORIGINS=*
# Swagger UI toggle; docs_url is currently hardcoded to /docs — api/main.py:192
# ENABLE_SWAGGER_UI=true
# The monitor currently starts unconditionally in lifespan — api/main.py:165
# ENABLE_MONITORING=true
# The evaluator is currently constructed unconditionally in lifespan — api/main.py:168
# ENABLE_EVALUATION=true


# ══════════════════════════════════════════════════════════════════════════════
# 3) Unimplemented: nothing reads these. They are kept only to mark direction.
# ══════════════════════════════════════════════════════════════════════════════

# No authentication layer yet (no JWT, OAuth or session code anywhere in the project)
# SECRET_KEY=
# JWT_SECRET_KEY=

# docker-compose.yml has no grafana service yet
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin

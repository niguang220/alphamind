# AlphaMind 环境变量配置示例
# 复制此文件为 .env 并填写实际值。
#
# 本文件分三段，读的时候请注意区别：
#   1) 已接通 —— 代码直接读取，改了立即生效
#   2) 待接出 —— 机制已实现，但参数当前写死在代码里；注释标了具体位置，接出来通常是一行
#   3) 未实现 —— 尚无对应代码，仅作路线图占位，设了也不会有任何效果

# ══════════════════════════════════════════════════════════════════════════════
# 1) 已接通
# ══════════════════════════════════════════════════════════════════════════════

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 用 deepseek-chat。不要用 deepseek-v4-pro：它是推理模型，thinking block 会吃光
# max_tokens 预算，导致 text block 为空、回复空白。
# ANTHROPIC_MODEL=deepseek-chat

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# 由 docker-compose.yml 消费（redis 服务的 --requirepass 与 REDIS_URL 拼装）
REDIS_PASSWORD=alphamind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
# ChromaDB 服务不可用时自动降级到这个本地路径
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
# 采样间隔（秒）
MONITOR_INTERVAL=10
# 告警 webhook，留空则只写日志不外发
ALERT_WEBHOOK_URL=

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ────────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
ALPHAMIND_SKILLS_DIR=./skills
ALPHAMIND_SKILLS_MAX_PROMPT_CHARS=5000


# ══════════════════════════════════════════════════════════════════════════════
# 2) 待接出：机制已实现，参数当前写死。下面的值就是代码里的现行默认值。
# ══════════════════════════════════════════════════════════════════════════════

# ── 意图识别 ──────────────────────────────────────────────────────────────────
# 三路融合投票低于此置信度则回落 OTHER —— core/intent_recognizer.py:168
# INTENT_CONFIDENCE_THRESHOLD=0.5
# 识别结果 LRU 缓存容量 —— core/intent_recognizer.py:233
# INTENT_CACHE_SIZE=1000

# ── Agent ─────────────────────────────────────────────────────────────────────
# 单次回复的 token 上限 —— agents/agent_orchestrator.py:182
# AGENT_MAX_TOKENS=2048

# ── MCP 工具治理 ──────────────────────────────────────────────────────────────
# 单次工具调用超时（秒）—— mcp/tool_manager.py:118
# TOOL_TIMEOUT=30
# 工具结果缓存 TTL（秒），0 = 不缓存 —— mcp/tool_manager.py:117
# TOOL_CACHE_TTL=0
# 熔断器：连续失败多少次后 OPEN —— mcp/tool_manager.py:80
# TOOL_CIRCUIT_BREAKER_THRESHOLD=5
# 熔断器：OPEN 后多少秒进入 HALF_OPEN 探活 —— mcp/tool_manager.py:80
# TOOL_CIRCUIT_BREAKER_TIMEOUT=60

# ── 记忆 ──────────────────────────────────────────────────────────────────────
# 工作记忆超过多少条触发 LLM 压缩 —— memory/conversation_memory.py:83
# MEMORY_MAX_WORKING=20

# ── 监控 ──────────────────────────────────────────────────────────────────────
# 滑窗 Z-score 异常检测灵敏度（超过几个标准差算异常）—— monitor/performance_monitor.py:69
# ANOMALY_DETECTION_SENSITIVITY=2.5

# ── API 行为 ──────────────────────────────────────────────────────────────────
# CORS 白名单，当前写死为 * —— api/main.py:197
# CORS_ORIGINS=*
# Swagger UI 开关，当前 docs_url 写死为 /docs —— api/main.py:192
# ENABLE_SWAGGER_UI=true
# Monitor 当前在 lifespan 里无条件启动 —— api/main.py:165
# ENABLE_MONITORING=true
# Evaluator 当前在 lifespan 里无条件构造 —— api/main.py:168
# ENABLE_EVALUATION=true


# ══════════════════════════════════════════════════════════════════════════════
# 3) 未实现：尚无对应代码，设了不会有任何效果。留在这里是为了标出后续方向。
# ══════════════════════════════════════════════════════════════════════════════

# 鉴权层尚未实现（全项目无 JWT / OAuth / 会话代码）
# SECRET_KEY=
# JWT_SECRET_KEY=

# docker-compose.yml 中尚无 grafana 服务
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin
